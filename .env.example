# IPTI configuration — copy to `.env` and fill in the tokens you have.
# Every provider is optional. A provider with no token is disabled automatically
# (in `auto` mode) and simply not counted — IPTI never crashes on a missing key.

# ---------------------------------------------------------------------------
# Threat-intelligence providers (at least one recommended; two for coverage)
# *_ENABLED accepts: auto | true | false
#   auto  -> enabled if a key is present, disabled if not
#   true  -> enabled; if the key is missing it is disabled with a warning
#   false -> always disabled, even when a key is present
# ---------------------------------------------------------------------------
IPTI_ABUSEIPDB_ENABLED=auto
ABUSEIPDB_API_KEY=

IPTI_VIRUSTOTAL_ENABLED=auto
VIRUSTOTAL_API_KEY=

IPTI_ALIENVAULT_OTX_ENABLED=auto
ALIENVAULT_API_KEY=

# ---------------------------------------------------------------------------
# Optional enrichment providers (identity + exposure context)
# ---------------------------------------------------------------------------
IPTI_IPINFO_ENABLED=auto
IPINFO_API_KEY=

IPTI_SHODAN_ENABLED=auto
SHODAN_API_KEY=

# ---------------------------------------------------------------------------
# HTTP behavior
# ---------------------------------------------------------------------------
IPTI_REQUEST_CONNECT_TIMEOUT=3.05
IPTI_REQUEST_READ_TIMEOUT=15
IPTI_REQUEST_RETRIES=2
IPTI_MAX_CONCURRENCY=8
IPTI_CACHE_TTL_SECONDS=3600
IPTI_ERROR_CACHE_TTL_SECONDS=60

# ---------------------------------------------------------------------------
# Evidence requirements
# ---------------------------------------------------------------------------
IPTI_MIN_SUCCESSFUL_THREAT_SOURCES=2
IPTI_MIN_THREAT_COVERAGE=0.67
IPTI_MAX_THREAT_AGE_DAYS=90
IPTI_ALLOW_STALE_EVIDENCE=false

# ---------------------------------------------------------------------------
# Provider weights (need NOT sum to 1.0; normalized dynamically at scoring time)
# ---------------------------------------------------------------------------
IPTI_ABUSEIPDB_WEIGHT=0.35
IPTI_VIRUSTOTAL_WEIGHT=0.40
IPTI_ALIENVAULT_OTX_WEIGHT=0.25

# ---------------------------------------------------------------------------
# Decision thresholds
# ---------------------------------------------------------------------------
IPTI_THREAT_REVIEW_THRESHOLD=30
IPTI_THREAT_DENY_THRESHOLD=70
IPTI_EXPOSURE_REVIEW_THRESHOLD=60
IPTI_IDENTITY_MINIMUM_CONFIDENCE=85

# ---------------------------------------------------------------------------
# Policy (context only — geography never makes an IP "malicious" and never
# changes the threat score; it only drives the DECISION). Comma-separated ISO
# country codes. All empty by default: out of the box no country is "risky".
#   RESTRICTED         -> hard block  => DENY
#   REQUIRE_APPROVAL   -> review reason => MANUAL_REVIEW
#   EXPECTED           -> any country NOT in this list => MANUAL_REVIEW
# Example: IPTI_RESTRICTED_COUNTRIES=KP,RU   IPTI_EXPECTED_COUNTRIES=US,GB,SG
# ---------------------------------------------------------------------------
IPTI_RESTRICTED_COUNTRIES=
IPTI_REQUIRE_APPROVAL_COUNTRIES=
IPTI_EXPECTED_COUNTRIES=
IPTI_BLOCK_TOR=true
IPTI_BLOCK_OPEN_PROXY=true

# Allow analysis of private/reserved IPs (default false; public IPs only).
IPTI_ALLOW_NON_GLOBAL=false
